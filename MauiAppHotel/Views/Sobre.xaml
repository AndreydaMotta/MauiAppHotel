<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre">

    <VerticalStackLayout Padding="30"
                         Spacing="20"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">

        <Label Text="Sobre o Aplicativo"
               FontFamily="Kalam"
               FontSize="32"
               TextColor="{StaticResource Primary}"
               HorizontalOptions="Center" />

        <Label Text="Aplicativo de contratação de hospedagem."
               FontSize="16"
               HorizontalTextAlignment="Center" />

        <BoxView HeightRequest="1"
                 WidthRequest="260"
                 Color="{StaticResource Gray300}" />

        <Label Text="Desenvolvedor"
               FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Label Text="Andrey Cyrineo da Motta"
               FontSize="18"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Label Text="Ano de desenvolvimento"
               FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Label Text="2026"
               FontSize="18"
               HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>
